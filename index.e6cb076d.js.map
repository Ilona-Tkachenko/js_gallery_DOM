"use strict";
var list = document.querySelector(".gallery__list");
var large = document.getElementById("largeImg");
// eslint-disable-next-line no-shadow
list.addEventListener("click", function(event) {
    event.preventDefault();
    var listItem = event.target.closest(".list-item");
    var link = listItem.querySelector(".list-item__link");
    large.src = link.href;
    large.alt = link.title;
});

